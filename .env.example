# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/panch?schema=public"

# Next.js local API
NEXT_PUBLIC_API_BASE_URL="/api/v1/en/"

# Auth (JWT)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Optional: seed admin override
ADMIN_EMAIL="admin@panchakanya.com"
ADMIN_PASSWORD="admin12345"

# Cloudinary (image & video storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Exposed to client for URL helpers only (same cloud name, not the secret)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
